{
  "name": "siyuan-ai",
  "version": "1.3.5",
  "private": true,
  "description": "SiYuan knowledge service layer for AI workflows",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r --parallel run dev",
    "test": "pnpm -r run test",
    "test:full": "powershell -ExecutionPolicy Bypass -File scripts/full-test.ps1",
    "test:full:skip-build": "powershell -ExecutionPolicy Bypass -File scripts/full-test.ps1 -SkipBuild",
    "lint": "eslint packages/*/src --ext .ts",
    "format": "prettier --write \"packages/*/src/**/*.ts\"",
    "typecheck": "pnpm -r run typecheck",
    "docker:build": "docker build -t siyuan-mcp-server ./docker",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "tsup": "^8.3.0",
    "vitest": "^2.1.0"
  }
}
